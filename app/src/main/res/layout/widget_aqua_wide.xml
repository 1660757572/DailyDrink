<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2：把首页那张大卡片原样搬到桌面——圆环进度、已喝/目标/剩余/连续、
     快捷容量与「喝一杯」。圆环用 RingProgressDrawable 接收 percent 的 level。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_drop" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_today"
            android:textColor="#5B5D63"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_target_preview"
            android:textColor="#5B5D63"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp">

            <ImageView
                android:id="@+id/widget_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_ring_placeholder" />

            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_percent_preview"
                android:textColor="#111114"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_drunk_label"
                android:textColor="#5B5D63"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_drink_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_value_preview"
                    android:textColor="#111114"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_ml_unit"
                    android:textColor="#5B5D63"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_remaining_preview"
                android:textColor="#5B5D63"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_badge_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_trophy" />

                <TextView
                    android:id="@+id/widget_badge_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_badge_preview_title"
                    android:textColor="#5B5D63"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_150"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg_light"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_preview_150"
            android:textColor="#5B5D63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_quick_200"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg_light"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_preview_200"
            android:textColor="#5B5D63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_quick_300"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg_light"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_preview_300"
            android:textColor="#5B5D63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_quick_500"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg_light"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_preview_500"
            android:textColor="#5B5D63"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/widget_action"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="7dp"
            android:layout_weight="2">

            <ImageView
                android:id="@+id/widget_action_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_action_shape" />

            <TextView
                android:id="@+id/widget_action_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_action_short"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
